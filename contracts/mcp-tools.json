{
  "schemaVersion": "1.1.0",
  "status": "authenticated-post-connect-resource-server",
  "authorizationBoundary": {
    "initialAuthorization": "cli-human-browser-only",
    "mcpAuthentication": "preconfigured-bearer",
    "credentialToolArguments": false,
    "credentialToolResults": false
  },
  "localProjectBridge": {
    "status": "post-connect-keychain-backed-stdio",
    "setupCommand": "attribution agent setup --host codex",
    "configurationContainsCredential": false,
    "toolArgumentsContainCredential": false,
    "toolResultsContainCredential": false,
    "contextBoundInputs": ["repository", "application", "run-manifest"],
    "tools": [
      "attribution_link_application",
      "attribution_upload_run",
      "attribution_ping",
      "attribution_live_check"
    ]
  },
  "tools": [
    {
      "name": "attribution_link_application",
      "title": "Confirm linked Attribution application",
      "description": "Use this when you need to confirm that the already-authorized MCP credential is scoped to the repository bundle identifier. This reads linkage only and never returns credentials.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundleId"],
        "properties": {
          "bundleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicationId", "organizationId", "bundleId"],
        "properties": {
          "applicationId": { "type": "string" },
          "organizationId": { "type": "string" },
          "bundleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "attribution_upload_run",
      "title": "Upload an exact Attribution verification run",
      "description": "Use this when the public CLI has produced last-run.json and you need the hosted live check to evaluate it. Supply canonical base64 of the exact bytes plus its SHA-256 Content-Digest and digest-derived idempotency key. Uploaded Device and Production claims are always downgraded by the control plane.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicationId", "manifestBytesBase64", "contentDigest", "idempotencyKey"],
        "properties": {
          "applicationId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "manifestBytesBase64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1398104,
            "contentEncoding": "base64",
            "description": "Canonical base64 of the exact last-run.json bytes within the 1 MiB decoded manifest limit."
          },
          "contentDigest": { "type": "string", "pattern": "^sha-256=:[A-Za-z0-9+/]{43}=:$" },
          "idempotencyKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifestUploadId", "status"],
        "properties": {
          "manifestUploadId": { "type": "string" },
          "status": { "enum": ["accepted", "duplicate"] }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "attribution_ping",
      "title": "Ping the Attribution control plane",
      "description": "Use this when you need to verify authenticated control-plane reachability for the linked application. This records connectivity only and can never create device or Apple Production evidence.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicationId", "idempotencyKey"],
        "properties": {
          "applicationId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "idempotencyKey": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pingId", "status", "productionEvidence"],
        "properties": {
          "pingId": { "type": "string" },
          "status": { "const": "reachable" },
          "productionEvidence": { "const": false }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "attribution_live_check",
      "title": "Read the Attribution live checklist",
      "description": "Use this when you need the labeled Config, Build, Your Logic, Device, and Production status for the linked application. Production passes only from qualifying verified Apple evidence in the private ledger.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicationId"],
        "properties": {
          "applicationId": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "outputSchema": {
        "$ref": "https://attribution.sh/contracts/live-status.v1.schema.json"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
